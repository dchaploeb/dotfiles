\export PATH=$HOME/bin:$PATH
export ZSH="$HOME/.oh-my-zsh"
export EDITOR=code
ZSH_THEME="agnoster"
CASE_SENSITIVE="true"
COMPLETION_WAITING_DOTS="true"
plugins=(zsh-syntax-highlighting zsh-autosuggestions colored-man-pages chezmoi)

[ -f "$HOME/.profile" ] && . "$HOME/.profile"
source $ZSH/oh-my-zsh.sh

ZSH_THEME_TERM_TAB_TITLE_IDLE="%n@%m: %~"
function custom_command_title() {
    title "%n@%m: ${1%% *}" "%n@%m: ${1%% *}"
}
preexec_functions+=(custom_command_title)

cd $HOME

function gamsrd() { "$HOME/bin/gam/gam" "$@" ; }
alias gam="~/bin/gamadv-xtd3/gam"
