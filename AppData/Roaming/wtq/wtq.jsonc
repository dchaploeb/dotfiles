{
	"$schema": "wtq.schema.json",
	"Apps": [
		{
			"Name": "Google Calendar",
			"Hotkeys": [
				{
					"Modifiers": "Alt, Control",
					"Key": "Q"
				},
				{
					"Modifiers": "Control",
					"KeyChar": "F2"
				}
			],
			"FileName": "brave.exe",
			"ArgumentList": [
				{
					"Argument": "--app=https://calendar.google.com"
				}
			],
			"WindowTitle": ".*Google Calendar.*"
		},
		{
			"Name": "Proton Mail",
			"Hotkeys": [
				{
					"Modifiers": "Alt, Control",
					"Key": "K"
				}
			],
			"FileName": "brave",
			"ArgumentList": [
				{
					"Argument": "--app=https://mail.proton.me"
				}
			],
			"WindowTitle": ".*Proton Mail.*",
			"TaskbarIconVisibility": "AlwaysVisible"
		},
		{
			"Name": "KeePassXC",
			"Hotkeys": [
				{
					"Modifiers": "Alt, Control",
					"KeyChar": "P"
				}
			],
			"FileName": "keepassxc"
		},
		{
			"Name": "Windows Terminal",
			"FileName": "wt",
			"ProcessName": "^WindowsTerminal$"
		}
	]
}