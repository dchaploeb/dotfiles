[user]
	name = David Chaplin-Loebell
	email = david@dcl.earth
[includeIf "hasconfig:remote.*.url:git@ssh.bitbucket.org:weaversway/**"]
    path = ~/.gitconfig-weaversway
[includeIf "hasconfig:remote.*.url:git@bitbucket.org:weaversway/**"]
    path = ~/.gitconfig-weaversway
[credential "https://github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential
[init]
	defaultBranch = main
[core]
{{- if .gui }}
	editor = code --wait
{{- else }}
    editor = nano
{{- end }}
    pager = cat
[commit]
	verbose = true
[merge]
    log = 10
[alias]
	recent = log --oneline --name-status -n 9
[help]
{{- if .gui }}
	format = web
{{- else }}
    format = man
{{ end }}
